# 数据库文件路径 (SQLite)。Docker 里挂载 volume 到 /data
DATABASE_URL="file:./data/app.db"

# iron-session 加密密钥，至少 32 字符。生产环境务必替换！
# 生成方法： openssl rand -base64 32
SESSION_SECRET="please-change-me-to-a-random-string-at-least-32-chars-long"

# 服务器端口
PORT=3000

# 是否禁用注册（第一个用户注册后可以设为 true 锁死）
DISABLE_REGISTRATION=false
