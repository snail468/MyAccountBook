# 数据库文件路径 (SQLite)。Docker 里挂载 volume 到 /data
DATABASE_URL="file:./data/app.db"

# iron-session 加密密钥，至少 32 字符。生产环境务必替换！
# 生成方法： openssl rand -base64 32
# 注意：NODE_ENV=production 下缺失或过短会**直接拒绝启动**（不再静默回退到
# 不安全的默认值）。开发环境只会打一条 warn。
SESSION_SECRET="please-change-me-to-a-random-string-at-least-32-chars-long"

# 服务器端口
PORT=3000

# 密码哈希（PBKDF2-SHA256）的迭代次数。不设则用 OWASP 推荐的 600000。
# 数值越大越安全但越耗 CPU（本机实测：600000 约 237ms，20000 约 8ms）。
# 迭代次数会写进哈希串本身，所以**改这个值不会让已有密码失效**，
# 老密码会在下次登录成功时自动按新值重算。
# 一般不用动它。往下调就是在降低安全强度（硬下限 10000），
# 只在部署环境有明确 CPU 约束时才考虑。
# PASSWORD_KDF_ITERATIONS=600000

# 会话 Cookie 是否只在 HTTPS 下发送。仅当整条链路是 HTTPS 时才设 true。
# HTTP 部署 (含内网/裸 IP:端口) 请保持 false，否则浏览器会拒收登录 cookie。
COOKIE_SECURE=false

# 注意：自助注册已由 admin 机制管理 —— 首次进入 App (0 用户) 允许注册且自动成为管理员；
# 之后新增用户只能由管理员在 /admin 页面创建。DISABLE_REGISTRATION 已废弃。

# 日志级别：debug / info / warn / error。不设时开发环境为 debug、生产为 info。
# 生产环境输出 JSON 单行，便于 docker logs 直接解析。
# LOG_LEVEL=info

# =============== 图片上传存到对象存储（可选）===============
# 默认把图片写在本地 data/uploads/，随数据卷一起备份，一般够用。
# 想改存对象存储就填下面四项 —— 走的是 S3 兼容 API（自己签 SigV4，没有 aws-sdk 依赖），
# MinIO / Backblaze B2 / Cloudflare R2 / AWS S3 都可以。
# 四项必须**全部**填齐才会启用，缺一个就继续走本地文件系统。
#
# 变量名带 R2_ 前缀是历史原因，与具体服务商无关。
# ACCOUNT_ID 用于拼 endpoint：https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# 换别的服务商需要相应改 src/lib/storage.ts 里的 r2Endpoint()。
#
# R2_ACCOUNT_ID="账号 ID"
# R2_ACCESS_KEY="access key"
# R2_SECRET_KEY="secret key"
# R2_BUCKET="myaccountbook-uploads"
