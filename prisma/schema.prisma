generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("user")
  createdAt    DateTime @default(now())

  // 会话失效：改密码 / 管理员重置 / 强制下线时 +1。
  // 已签发的 cookie 里带着旧值，校验不过就当未登录 ——
  // 否则 iron-session 的 30 天有效期内，改完密码旧会话依然能用。
  sessionVersion Int @default(0)

  // 登录限流：连续失败累加，成功清零。lockedUntil 到点前拒绝尝试。
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  entries       Entry[]
  events        Event[]
  ledgers       Ledger[]
  memberships   TripMember[]
  bankCards     BankCard[]
}

// ============ 工作账本 (built-in kind="work") ============
model Entry {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  yearMonth    String
  category     String
  direction    String
  amountCents  Int
  note         String?
  occurredAt   DateTime  @default(now())
  refundedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, yearMonth])
}

// ============ 桃源账本 (built-in kind="taoyuan") ============
model Event {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  startAt        DateTime?
  content        String?
  rewardMethod   String?
  rewardMethods  String?
  reward         String?
  topicTag       String?
  contentImages  String?
  publishedAt    DateTime      @default(now())
  participate    Boolean       @default(true)
  deadline       DateTime?
  predictedCents Int?
  announcedCents Int?
  paidCents      Int?
  predictedAt    DateTime?
  announcedAt    DateTime?
  paidAt         DateTime?
  status         String        @default("published")
  note           String?
  parentId       String?
  parent         Event?        @relation("EventMerge", fields: [parentId], references: [id], onDelete: SetNull)
  children       Event[]       @relation("EventMerge")
  amounts        EventAmount[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, status])
  @@index([parentId])
}

model EventAmount {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stage        String
  cents        Int
  note         String?
  rewardMethod String?
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([eventId, stage])
}

// ============ 账本 (通用容器) ============
// kind: work | taoyuan | general | travel
//   work / taoyuan: 仅作为"用户已启用"的标记，实际数据在 Entry / Event
//   general: 数据在 GeneralEntry
//   travel: 数据在 TripExpense + TripMember + TripSplit
model Ledger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  name      String
  icon      String?
  color     String?
  order     Int      @default(0)
  archived  Boolean  @default(false)
  // 软删除：非空 = 在回收站；60 天后 cleanup 会硬删
  deletedAt DateTime?

  // 普通账本：月度总预算
  budgetCents Int?
  // 普通账本：类别自定义（JSON）—— { added: {name,icon,direction}[], hidden: string[] }
  customCategories String?

  // 旅游账本：本币 + 日期
  baseCurrency String?
  startDate    DateTime?
  endDate      DateTime?

  entries      GeneralEntry[]
  tripMembers  TripMember[]
  tripExpenses TripExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, order])
  // 唯一性由应用层保证：work/taoyuan 每用户仅一条；general/travel 可多条
}

// ============ 普通账本条目 ============
model GeneralEntry {
  id          String   @id @default(cuid())
  ledgerId    String
  ledger      Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  direction   String   // "income" | "expense"
  category    String
  amountCents Int
  tags        String?  // 逗号分隔
  note        String?
  imageUrls   String?  // JSON array
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([ledgerId, occurredAt])
}

// ============ 旅游账本 ============
model TripMember {
  id          String   @id @default(cuid())
  ledgerId    String
  ledger      Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  userId      String?  // 应用内用户；null 表示纯名字占位
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName String
  createdAt   DateTime @default(now())

  paidExpenses TripExpense[]
  splits       TripSplit[]

  @@index([ledgerId])
}

model TripExpense {
  id                 String   @id @default(cuid())
  ledgerId           String
  ledger             Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  payerId            String
  payer              TripMember @relation(fields: [payerId], references: [id], onDelete: Cascade)
  title              String
  category           String
  phase              String   // "pre" | "during"
  currency           String   // "CNY" | "JPY" | ...
  amountForeignCents Int      // 外币，以分为单位
  rate               Float    // 1 外币 = rate 本币
  amountBaseCents    Int      // 本币，冗余存储便于查询
  note               String?
  imageUrls          String?  // JSON array
  occurredAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  splits TripSplit[]

  @@index([ledgerId, phase])
}

model TripSplit {
  id         String @id @default(cuid())
  expenseId  String
  expense    TripExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId   String
  member     TripMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  shareCents Int  // 该成员应承担的本币金额（分）

  @@index([expenseId])
  @@index([memberId])
}

// ============ 汇率缓存 ============
model CurrencyRate {
  id         String   @id @default(cuid())
  base       String   // 通常固定 "CNY"
  quote      String
  rate       Float    // 1 quote = rate base
  fetchedAt  DateTime @default(now())

  @@unique([base, quote])
}

// ============ 银行卡备份（加密存储） ============
//
// 威胁模型与加密方案见 src/lib/cardCrypto.ts。
//
// 字段分两类：
//   * 明文：银行名、别名、卡类型、持卡人、**尾号** —— 列表页要显示，
//     单独存尾号是为了列出卡片时不必把所有卡号都解密一遍
//   * 密文：完整卡号、备注 —— AES-256-GCM，格式 v1$<iv>$<密文>
//
// **刻意没有 CVV 和取款密码字段**。它们不是"加密后就能存"的东西，
// 支付行业规范明确禁止存储 CVV，本应用也没有任何场景需要。
// 从 schema 层面不给这两个字段，就杜绝了以后有人"顺手加一个"。
model BankCard {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bankName String  // 银行名，如"招商银行"
  alias    String? // 用户自己起的别名，如"工资卡"
  cardType String  // "debit" | "credit"
  holder   String? // 持卡人姓名
  last4    String  // 卡号后四位，明文

  numberEnc String  // 完整卡号密文
  noteEnc   String? // 备注密文

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, order])
}
