generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("user")   // "admin" | "user"
  createdAt    DateTime @default(now())

  entries Entry[]
  events  Event[]
}

// 工作账本条目
model Entry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  yearMonth String
  category  String
  direction String
  amountCents Int
  note      String?

  occurredAt DateTime @default(now())
  refundedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, yearMonth])
}

// 桃源活动
// 状态由 amounts 派生：有 paid → paid；有 announced → announced；有 predicted → predicted；否则 published
// 旧的 predictedCents/announcedCents/paidCents 保留作为兼容层，新数据走 EventAmount
model Event {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  startAt     DateTime?
  content     String?

  // 兼容：旧单值 rewardMethod。新版用 rewardMethods (JSON array) 支持多选 + 自定义（"custom:名字"）
  rewardMethod  String?
  rewardMethods String?

  reward      String?
  topicTag    String?

  // 内容图片 JSON array of URL strings
  contentImages String?

  publishedAt DateTime @default(now())
  participate Boolean  @default(true)
  deadline    DateTime?

  // 旧单值兼容（无 EventAmount 时作为 fallback）
  predictedCents Int?
  announcedCents Int?
  paidCents      Int?
  predictedAt    DateTime?
  announcedAt    DateTime?
  paidAt         DateTime?

  status String @default("published")
  note   String?

  parentId  String?
  parent    Event?  @relation("EventMerge", fields: [parentId], references: [id], onDelete: SetNull)
  children  Event[] @relation("EventMerge")

  amounts   EventAmount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([parentId])
}

// 单个活动某个阶段可以有多条金额
model EventAmount {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stage        String   // 'predicted' | 'announced' | 'paid'
  cents        Int
  note         String?
  rewardMethod String?  // 该笔金额自带的发放方式（仅 paid 阶段进入 A/C/D 归类）
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([eventId, stage])
}
