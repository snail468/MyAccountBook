generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("user")
  createdAt    DateTime @default(now())

  // 会话失效：改密码 / 管理员重置 / 强制下线时 +1。
  // 已签发的 cookie 里带着旧值，校验不过就当未登录 ——
  // 否则 iron-session 的 30 天有效期内，改完密码旧会话依然能用。
  sessionVersion Int @default(0)

  // 登录限流：连续失败累加，成功清零。lockedUntil 到点前拒绝尝试。
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // 用户偏好（JSON blob）。目前只装首页"总收入组成"配置 ——
  //   { incomeComponents: { "B": true, "C": false, "gen:<ledgerId>": true } }
  // 见 src/lib/userPrefs.ts。未来添别的偏好也塞这里，不用每次加列。
  preferences String?

  entries       Entry[]
  events        Event[]
  ledgers       Ledger[]
  memberships   TripMember[]
  bankCards     BankCard[]
  recurringRules RecurringRule[]

  // B7 账本共享：跨账本的 ACL 成员身份，与 TripMember（旅游同伴占位）是两回事。
  ledgerMemberships LedgerMember[]
  createdInvites    LedgerInvite[] @relation("InviteCreator")
  acceptedInvites   LedgerInvite[] @relation("InviteAcceptor")
}

// ============ 工作账本 (kind="work") ============
//
// B7 Phase 2：Entry 挂到 Ledger 上，权限判断走 LedgerMember（不再直接看 userId）。
//   * ledgerId —— 归属；共享账本时同一 ledgerId 会对应多个 userId 的 Entry
//   * userId   —— **创建者**（谁写的这一笔），共享账本里保留有意义，
//                 报表/审计能追溯来源；但**不再是权限判断依据**
// 幂等键 UNIQUE 也从 (userId,clientId) 换成 (ledgerId,clientId)：客户端的
// 离线队列本来就是 per-ledger 的，key 落到 ledgerId 上更贴近语义。
model Entry {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerId     String
  ledger       Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  yearMonth    String
  category     String
  direction    String
  amountCents  Int
  note         String?
  occurredAt   DateTime  @default(now())
  refundedAt   DateTime?
  createdAt    DateTime  @default(now())
  // 软删除：非空 = 在回收站，60 天后由 purgeExpiredRecords 硬删。
  // **所有金额聚合都必须过滤 deletedAt=null** —— 漏一处就把已删条目当有效数据算，
  // 总额会悄悄错。见 src/lib/softDelete.ts 的 NOT_DELETED。
  deletedAt    DateTime?
  // 离线记账幂等键 —— 客户端在离线队列里生成 UUID，联网重放时后端见到
  // 相同 (ledgerId, clientId) 直接返回已有 id。见 src/lib/offlineQueue.ts。
  clientId     String?

  @@index([ledgerId, yearMonth])
  @@index([ledgerId, deletedAt])
  @@unique([ledgerId, clientId])
}

// ============ 桃源账本 (kind="taoyuan") ============
// B7 Phase 2：同 Entry —— ledgerId 归属，userId 只是创建者。
model Event {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerId       String
  ledger         Ledger        @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  title          String
  startAt        DateTime?
  content        String?
  rewardMethod   String?
  rewardMethods  String?
  reward         String?
  topicTag       String?
  contentImages  String?
  publishedAt    DateTime      @default(now())
  participate    Boolean       @default(true)
  deadline       DateTime?
  predictedCents Int?
  announcedCents Int?
  paidCents      Int?
  predictedAt    DateTime?
  announcedAt    DateTime?
  paidAt         DateTime?
  status         String        @default("published")
  note           String?
  parentId       String?
  parent         Event?        @relation("EventMerge", fields: [parentId], references: [id], onDelete: SetNull)
  children       Event[]       @relation("EventMerge")
  amounts        EventAmount[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  // 软删除。见 src/lib/softDelete.ts。
  deletedAt      DateTime?
  // 离线记账幂等键。见 src/lib/offlineQueue.ts。
  clientId       String?

  @@index([ledgerId, status])
  @@index([parentId])
  @@index([ledgerId, deletedAt])
  @@unique([ledgerId, clientId])
}

model EventAmount {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stage        String
  // 金额（分）。**非金额奖励一律存 0** —— 这样所有既有的金额聚合天然不受影响。
  // 计量方式由 rewardMethod 决定，见 src/lib/rewardMethod.ts 的 rewardValueKind
  cents        Int
  // 个数类奖励：Q币、萝卜币多少个
  quantity     Int?
  // 文字类奖励：什么周边 / 什么自定义
  itemDesc     String?
  note         String?
  rewardMethod String?
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  // 软删除。见 src/lib/softDelete.ts。
  deletedAt    DateTime?

  @@index([eventId, stage])
  @@index([eventId, deletedAt])
}

// ============ 账本 (通用容器) ============
// kind: work | taoyuan | general | travel
//   work / taoyuan: 仅作为"用户已启用"的标记，实际数据在 Entry / Event
//   general: 数据在 GeneralEntry
//   travel: 数据在 TripExpense + TripMember + TripSplit
model Ledger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  name      String
  icon      String?
  color     String?
  order     Int      @default(0)
  archived  Boolean  @default(false)
  // 软删除：非空 = 在回收站；60 天后 cleanup 会硬删
  deletedAt DateTime?

  // 普通账本：月度总预算
  budgetCents Int?
  // 普通账本：类别自定义（JSON）—— { added: {name,icon,direction}[], hidden: string[] }
  customCategories String?

  // 旅游账本：本币 + 日期
  baseCurrency String?
  startDate    DateTime?
  endDate      DateTime?

  entries      GeneralEntry[]
  tripMembers  TripMember[]
  tripExpenses TripExpense[]
  recurringRules RecurringRule[]

  // B7 Phase 2：kind=work/taoyuan 时挂到这两张关系上
  workEntries    Entry[]
  taoyuanEvents  Event[]

  // B7 账本共享：这条 Ledger 上有哪些协作成员、有哪些未使用的邀请
  members  LedgerMember[]
  invites  LedgerInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, order])
  // 唯一性由应用层保证：work/taoyuan 每用户仅一条；general/travel 可多条
}

// ============ 账本协作（B7） ============
//
// 账本共享的 ACL 表。角色阶梯 owner > editor > viewer：
//   owner  —— 建者本人；能改账本设置、邀请/踢人、软删/恢复/永删账本
//   editor —— 能增删改条目
//   viewer —— 只读
//
// 与 Ledger.userId 的关系：Ledger.userId 仍在，保持"建者"语义（导出/迁移/
// 老逻辑仍能拿到一个稳定的 user），但**权限判断一律走本表** —— 见
// src/lib/ownership.ts。回填脚本会为每个现有 Ledger 建一条 owner 行。
//
// 与 TripMember 的关系：两者独立。TripMember 是旅游账本的"参与人占位"，
// 可以是纯名字（displayName），也可以关联 userId；LedgerMember 才是能进
// 这个账本的用户。用户接受旅游账本邀请时，UI 会引导他绑定到某个 TripMember。
model LedgerMember {
  id        String   @id @default(cuid())
  ledgerId  String
  ledger    Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "owner" | "editor" | "viewer"。Prisma 的 SQLite 无 enum，用字符串。
  // 校验放在 src/lib/ledgerRole.ts，禁止绕过。
  role      String
  createdAt DateTime @default(now())

  @@unique([ledgerId, userId])
  @@index([userId])
}

// 一次性邀请码：owner 生成 token，被邀请者登录后 POST /api/invites/[token] 接受。
// 接受成功后 acceptedByUserId / acceptedAt 落库，同一 token 再用会被拒。
//
// **不搞永久邀请链接**：token 一旦落库就无法撤回给持有者手里的那份，
// 一次性 + 短有效期是最保守的选择；owner 想再邀请就再生成一个。
model LedgerInvite {
  id              String    @id @default(cuid())
  ledgerId        String
  ledger          Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  // 32 字节随机 base64url —— 客户端拼进 /invite/<token> 链接
  token           String    @unique
  role            String    // 邀请后落到 LedgerMember 的角色
  createdByUserId String
  createdBy       User      @relation("InviteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  // 到期时间。null 表示不过期（当前 UI 一律给 7 天，后端不强制）
  expiresAt       DateTime?
  acceptedByUserId String?
  acceptedBy      User?     @relation("InviteAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  acceptedAt      DateTime?

  @@index([ledgerId])
}

// ============ 普通账本条目 ============
model GeneralEntry {
  id          String   @id @default(cuid())
  ledgerId    String
  ledger      Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  direction   String   // "income" | "expense"
  category    String
  amountCents Int
  tags        String?  // 逗号分隔
  note        String?
  imageUrls   String?  // JSON array
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  // 软删除。见 src/lib/softDelete.ts。
  deletedAt   DateTime?
  // 离线记账幂等键：客户端在入队时生成一个 UUID，后端见到相同 clientId +
  // ledgerId 时直接返回已有的 id，重放安全。
  //
  // 为什么放在 GeneralEntry 而不是所有表：普通账本是最常用于日常"随手记"的
  // 场景 —— 也就最容易在断网时错过一笔。工作/桃源/旅游用户是坐在电脑前
  // 有意识地维护的，先不上离线队列。见 src/lib/offlineQueue.ts。
  //
  // SQLite 允许 UNIQUE 里出现多个 NULL，所以历史条目（clientId=null）
  // 不会互相冲突，只有客户端明确传了 UUID 的条目才走去重路径。
  clientId    String?

  @@index([ledgerId, occurredAt])
  @@index([ledgerId, deletedAt])
  @@unique([ledgerId, clientId])
}

// ============ 旅游账本 ============
model TripMember {
  id          String   @id @default(cuid())
  ledgerId    String
  ledger      Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  userId      String?  // 应用内用户；null 表示纯名字占位
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName String
  createdAt   DateTime @default(now())

  paidExpenses TripExpense[]
  splits       TripSplit[]

  @@index([ledgerId])
}

model TripExpense {
  id                 String   @id @default(cuid())
  ledgerId           String
  ledger             Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  payerId            String
  payer              TripMember @relation(fields: [payerId], references: [id], onDelete: Cascade)
  title              String
  category           String
  phase              String   // "pre" | "during"
  currency           String   // "CNY" | "JPY" | ...
  amountForeignCents Int      // 外币，以分为单位
  rate               Float    // 1 外币 = rate 本币
  amountBaseCents    Int      // 本币，冗余存储便于查询
  note               String?
  imageUrls          String?  // JSON array
  occurredAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  // 软删除。见 src/lib/softDelete.ts。
  // **旅游账本尤其危险**：软删的支出必须排除，否则成员净额和最优结算直接算错。
  deletedAt          DateTime?
  // 离线记账幂等键。见 src/lib/offlineQueue.ts。
  clientId           String?

  splits TripSplit[]

  @@index([ledgerId, phase])
  @@index([ledgerId, deletedAt])
  @@unique([ledgerId, clientId])
}

model TripSplit {
  id         String @id @default(cuid())
  expenseId  String
  expense    TripExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  memberId   String
  member     TripMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  shareCents Int  // 该成员应承担的本币金额（分）

  @@index([expenseId])
  @@index([memberId])
}

// ============ 汇率缓存 ============
model CurrencyRate {
  id         String   @id @default(cuid())
  base       String   // 通常固定 "CNY"
  quote      String
  rate       Float    // 1 quote = rate base
  fetchedAt  DateTime @default(now())

  @@unique([base, quote])
}

// ============ 银行卡备份（加密存储） ============
//
// 威胁模型与加密方案见 src/lib/cardCrypto.ts。
//
// 字段分两类：
//   * 明文：银行名、别名、卡类型、持卡人、**尾号** —— 列表页要显示，
//     单独存尾号是为了列出卡片时不必把所有卡号都解密一遍
//   * 密文：完整卡号、备注 —— AES-256-GCM，格式 v1$<iv>$<密文>
//
// **刻意没有 CVV 和取款密码字段**。它们不是"加密后就能存"的东西，
// 支付行业规范明确禁止存储 CVV，本应用也没有任何场景需要。
// 从 schema 层面不给这两个字段，就杜绝了以后有人"顺手加一个"。
model BankCard {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bankName String  // 银行名，如"招商银行"
  alias    String? // 用户自己起的别名，如"工资卡"
  cardType String  // "debit" | "credit"
  holder   String? // 持卡人姓名
  last4    String  // 卡号后四位，明文

  numberEnc String  // 完整卡号密文
  noteEnc   String? // 备注密文

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, order])
}

// ============ 周期记账规则 ============
//
// 房租、订阅、工资这类固定项：配置一次，到期自动生成或提醒确认。
// 排期计算（含月末钳制、补跑漏掉的期）在 src/lib/recurring.ts。
//
// target 决定生成到哪里：
//   "work"    → Entry（Phase 2 之后 Entry 也 ledger-scoped，ledgerId 必填）
//   "general" → GeneralEntry（ledgerId 必填）
// 旅游账本不支持 —— 它的支出必须带付款人与分摊，没法凭规则自动编一笔出来。
model RecurringRule {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  target   String // "work" | "general"
  ledgerId String
  ledger   Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  direction   String
  category    String
  amountCents Int
  note        String?

  frequency  String    // "monthly" | "weekly"
  dayOfMonth Int?      // monthly：1-31，超出当月天数落到月末
  dayOfWeek  Int?      // weekly：0=周日 … 6=周六
  startDate  DateTime
  endDate    DateTime?

  // false = 只提醒不自动生成，用户自己确认后再记
  autoCreate Boolean @default(true)
  active     Boolean @default(true)
  // 已经生成到哪一期。null 表示一期都还没生成
  lastGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active])
}
